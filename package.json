{
  "name": "hootowl-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HootOwl Lead Rescue: missed-call text-back backend (Twilio + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "twilio": "^6.1.2"
  }
}
