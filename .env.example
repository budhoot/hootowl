# HootOwl backend settings.
#
# Do NOT put real passwords in this file - it is committed to Git.
# Run `npm run setup` to create your private .env file with strong random passwords,
# then edit .env (never this file) to change any value later.

# Port the API listens on.
PORT=3000

# Public https address where Twilio can reach this API (no trailing slash).
# Locally use your ngrok address, e.g. https://abcd-12-34.ngrok-free.app
# In production, e.g. https://api.hootowl.net
PUBLIC_BASE_URL=https://your-public-api-address.example

# Optional: your free fixed ngrok domain (ngrok dashboard -> Domains), e.g. owl-example.ngrok-free.app
# When set, the desktop shortcut also starts ngrok with it. Set PUBLIC_BASE_URL to https://<this domain>.
NGROK_DOMAIN=

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://hootowl:change-me@localhost:5432/hootowl

# Secret the HootOwl operator sends as "Authorization: Bearer <key>" to use /admin.
# At least 24 characters.
ADMIN_API_KEY=change-me-to-a-long-random-secret

# From https://console.twilio.com (Account Info box on the dashboard).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me

# Optional tuning (defaults shown).
# DIAL_TIMEOUT_SECONDS=20
# WORKER_POLL_INTERVAL_MS=5000
# RECOVERY_COOLDOWN_HOURS=24
# STUCK_SENDING_MINUTES=10

# Only for `npm test`. This database is WIPED on every test run - never point it at real data.
TEST_DATABASE_URL=postgres://hootowl:change-me@localhost:5432/hootowl_test
